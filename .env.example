# Copia este fichero como .env y ajusta los valores. Nunca se sube el .env real.
NODE_ENV=development

# Obligatorio en producción: clave para firmar la cookie de sesión (mínimo 32 caracteres).
# Sin ella, en desarrollo se usa una temporal y las sesiones se pierden al reiniciar.
# WEBFORGE_SESSION_SECRET=

WEBFORGE_HOST=127.0.0.1
WEBFORGE_PORT=8787
WEBFORGE_DB_PATH=data/webforge.sqlite
WEBFORGE_SESSION_TTL_HOURS=12

# 1 fuerza cookies Secure; en producción ya están activas por defecto.
# WEBFORGE_SECURE_COOKIES=0

# Orígenes adicionales aceptados en mutaciones, separados por comas.
# WEBFORGE_ALLOWED_ORIGINS=https://app.dominio.dev

# 0 desactiva el auto-registro; el panel de administración puede cambiarlo sin reiniciar.
WEBFORGE_ALLOW_REGISTRATION=1

# Solo para npm run seed:admin. Si no se define la contraseña, se genera y se muestra una vez.
# WEBFORGE_ADMIN_EMAIL=admin@dominio.dev
# WEBFORGE_ADMIN_PASSWORD=

# Cifra las variables de entorno en reposo y el secreto TOTP. Si no se define, se deriva
# de la sesión: en producción conviene una clave propia de 32+ caracteres.
# WEBFORGE_ENV_KEY=

# Correo real por SMTP. Sin esto, los enlaces quedan en la bandeja del servidor.
# Con Gmail hace falta una contraseña de aplicación, no la de la cuenta.
# WEBFORGE_SMTP_URL=smtps://usuario:clave-de-aplicacion@smtp.gmail.com:465
# WEBFORGE_MAIL_FROM=WebForge <no-reply@dominio.dev>
# URL pública para los enlaces de los correos (por defecto http://localhost:5173 en desarrollo).
# WEBFORGE_PUBLIC_URL=https://app.dominio.dev

# Jaula de ejecuciones: topes por proceso.
# WEBFORGE_RUN_CPU_SEGUNDOS=20
# WEBFORGE_RUN_FICHERO_KB=4096
# WEBFORGE_RUN_TMPFS_MB=32
# WEBFORGE_RUN_TIEMPO_MS=30000
# WEBFORGE_RUN_SALIDA_KB=64
# WEBFORGE_RUN_PROCESOS=256
# WEBFORGE_RUN_MEMORIA_MB=512
# WEBFORGE_RUN_DESCRIPTORES=256
